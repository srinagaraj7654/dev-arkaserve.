# ─────────────────────────────────────────────────────────────────────────────
# STAGING / DEV DEPLOYMENT — copy this file to .env.staging and fill in values
# Used by: npm run build:staging  (deploys the `dev` branch)
#
# Points at the same EC2 backend as production (single server setup).
# The app shows a "STAGING" banner so users know they're on the dev build.
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project.supabase.co
# ⚠️  ANON key only — get from: Supabase Dashboard → Project Settings → API → anon/public
VITE_SUPABASE_KEY=your-supabase-anon-key

# Staging hits the same backend as production (single EC2 server setup)
VITE_API_URL=https://129-154-254-119.sslip.io

VITE_APP_ENV=staging
VITE_ADMIN_KEY=your-admin-key

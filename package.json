{
  "name": "mocktest-platform-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "dev:staging": "vite --mode staging",
    "build": "vite build --mode production",
    "build:staging": "vite build --mode staging",
    "preview": "vite preview",
    "preview:staging": "vite build --mode staging && vite preview",
    "build:native": "vite build --config vite.config.native.js",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run build:native && npx cap sync android && npx cap open android",
    "cap:ios": "npm run build:native && npx cap sync ios && npx cap open ios",
    "dev:native": "vite --config vite.config.native.js"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@supabase/supabase-js": "^2.47.0",
    "axios": "^1.7.9",
    "dompurify": "^3.4.17",
    "katex": "^0.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

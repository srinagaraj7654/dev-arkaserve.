    {
      "name": "Topic Practice",
      "short_name": "Practice",
      "url": "/?start=topic",
      "icon": "https://prep.arkaserve.com/icon-192.png"
    }
  ],
  "signingKey": {
    "path": "./android.keystore",
    "alias": "mocktest-key"
  },
  "orientation": "portrait",
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "fullScopeUrl": "https://prep.arkaserve.com/",
  "minSdkVersion": 21,

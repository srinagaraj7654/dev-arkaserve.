{
  "packageId": "com.arkaserve.prep",
  "host": "prep.arkaserve.com",
  "name": "MockTest",
  "launcherName": "MockTest",
  "display": "standalone",
  "themeColor": "#FF653F",
  "navigationColor": "#FF653F",
  "navigationColorDark": "#FF653F",
  "navigationDividerColor": "#FF653F",
  "navigationDividerColorDark": "#FF653F",
  "backgroundColor": "#ffffff",
  "startUrl": "/",
  "iconUrl": "https://prep.arkaserve.com/icon-512.png",
  "maskableIconUrl": "https://prep.arkaserve.com/icon-maskable-512.png",
  "monochromeIconUrl": "https://prep.arkaserve.com/icon-192.png",
  "splashScreenFadeOutDuration": 300,
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://prep.arkaserve.com/manifest.json",
  "fallbackType": "customtabs",
  "features": {
    "locationDelegation": { "enabled": false },
    "playBilling": { "enabled": false }
  },
  "alphaDependencies": { "enabled": false },

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT — copy this file to .env.development and fill in values
# Used by: npm run dev
#
# API calls go to /api/* which Vite proxies to http://localhost:8000
# (see proxy config in vite.config.js — no VITE_API_URL needed)
# If you don't have the backend running locally, set VITE_API_URL to the EC2
# URL below but note you will be hitting the shared production backend.
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project.supabase.co
# ⚠️  ANON key only — get from: Supabase Dashboard → Project Settings → API → anon/public
VITE_SUPABASE_KEY=your-supabase-anon-key

# Empty = use Vite proxy → localhost:8000 (recommended when backend runs locally)
# Set to https://129-154-254-119.sslip.io to hit the shared EC2 backend instead
VITE_API_URL=

VITE_APP_ENV=development
VITE_ADMIN_KEY=your-admin-key

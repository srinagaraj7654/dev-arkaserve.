# ─────────────────────────────────────────────────────────────────────────────
# MockTest Frontend — Environment Variables Template
# Copy the relevant file for your environment:
#   Local dev  →  copy this to .env.development
#   Staging    →  copy this to .env.staging
#   Production →  copy this to .env.production
#
# ⚠️  SECURITY: ALWAYS use the ANON (public) key from Supabase.
#     NEVER use the service_role key in any frontend env file.
#     The service_role key bypasses all Row Level Security.
#     Get the anon key: Supabase Dashboard → Project Settings → API → anon/public
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
# ⚠️  Use the ANON key (labeled "anon / public") — NOT the service_role key
VITE_SUPABASE_KEY=your-supabase-anon-key

# ── Backend API ───────────────────────────────────────────────────────────────
# Development: leave empty → Vite proxy forwards /api/* to localhost:8000
# Staging/Prod: full HTTPS URL of your EC2 backend
VITE_API_URL=

# ── App environment label (shown in staging banner) ───────────────────────────
# Values: development | staging | production
VITE_APP_ENV=development

# ── Admin panel access key ────────────────────────────────────────────────────
VITE_ADMIN_KEY=your-admin-key

# Admin access server (server-for-admin-panel-). Leave EMPTY to keep the admin panel as before.
# Local testing: put VITE_ACCESS_API_URL=http://localhost:4000 in your own .env.development (not committed).
VITE_ACCESS_API_URL=
